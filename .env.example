# Application Environment
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://zentra_user:zentra_dev_password@localhost:5432/zentra_db?schema=public

# Redis Connection (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration (Replace with secure random strings)
JWT_ACCESS_SECRET=replace_with_secure_random_secret
JWT_REFRESH_SECRET=replace_with_secure_random_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Active College-Project OTP Provider Configuration (mock)
OTP_PROVIDER=mock
MOCK_OTP_CODE=123456

# OTP Security Policy
OTP_VALIDITY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# =================================================================
# OPTIONAL FUTURE PRODUCTION SMS PROVIDER (NOT REQUIRED FOR DEMO)
# =================================================================
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_OTP_TEMPLATE_ID=your_msg91_template_id_here
# MSG91_OTP_API_URL=https://control.msg91.com/api/v5/otp
# MSG91_VERIFY_OTP_API_URL=https://control.msg91.com/api/v5/otp/verify
